<?xml version="1.0"?>
<!--
  Three Crazyflie 2.x, each with its own Lee controller and trajectory (thesis, 6.7).

    roslaunch rotors_gazebo crazyflie2_swarm_lee_geometric_controller.launch

  Namespaces: crazyflie2_1, crazyflie2_2, crazyflie2_3. Trajectories:
  resource/trajectories/swarm_crazyflie2_<i>.yaml. They all start at the same sim
  time, so the drones move together.
-->
<launch>
  <arg name="mav_name" default="crazyflie2"/>
  <arg name="world_name" default="basic"/>
  <arg name="enable_logging" default="false"/>
  <arg name="enable_ground_truth" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="debug" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="verbose" default="false"/>

  <env name="GAZEBO_MODEL_PATH" value="${GAZEBO_MODEL_PATH}:$(find rotors_gazebo)/models"/>
  <env name="GAZEBO_RESOURCE_PATH" value="${GAZEBO_RESOURCE_PATH}:$(find rotors_gazebo)/models"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find rotors_gazebo)/worlds/$(arg world_name)_crazyflie.world"/>
    <arg name="debug" value="$(arg debug)" />
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)" />
    <arg name="verbose" value="$(arg verbose)"/>
  </include>

  <!-- CRAZYFLIE_1 -->
  <group ns="$(arg mav_name)_1">
    <include file="$(find rotors_gazebo)/launch/spawn_mav_crazyflie.launch">
      <arg name="mav_name" value="$(arg mav_name)" />
      <arg name="namespace" value="$(arg mav_name)_1" />
      <arg name="model" value="$(find rotors_description)/urdf/mav_generic_odometry_sensor.gazebo" />
      <arg name="enable_logging" value="$(arg enable_logging)" />
      <arg name="enable_ground_truth" value="$(arg enable_ground_truth)" />
      <arg name="log_file" value="$(arg mav_name)_1"/>
      <arg name="forster_parameters" value="true"/>
      <!-- Set the initial position -->
      <arg name="x" value="0.0"/>
      <arg name="y" value="0.0"/>
    </include>
    <node name="lee_geometric_controller_node" pkg="rotors_control" type="lee_geometric_controller_node" output="screen">
      <rosparam command="load" file="$(find rotors_gazebo)/resource/$(arg mav_name)_lee_geometric_controller.yaml" />
      <rosparam command="load" file="$(find rotors_gazebo)/resource/$(arg mav_name)_forster_motor_parameters.yaml" />
    </node>
    <node name="piecewise_trajectory_generator" pkg="rotors_gazebo" type="piecewise_trajectory_generator" output="screen">
      <rosparam command="load" file="$(find rotors_gazebo)/resource/trajectories/swarm_$(arg mav_name)_1.yaml" />
    </node>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
  </group>

  <!-- CRAZYFLIE_2 -->
  <group ns="$(arg mav_name)_2">
    <include file="$(find rotors_gazebo)/launch/spawn_mav_crazyflie.launch">
      <arg name="mav_name" value="$(arg mav_name)" />
      <arg name="namespace" value="$(arg mav_name)_2" />
      <arg name="model" value="$(find rotors_description)/urdf/mav_generic_odometry_sensor.gazebo" />
      <arg name="enable_logging" value="$(arg enable_logging)" />
      <arg name="enable_ground_truth" value="$(arg enable_ground_truth)" />
      <arg name="log_file" value="$(arg mav_name)_2"/>
      <arg name="forster_parameters" value="true"/>
      <!-- Set the initial position -->
      <arg name="x" value="1.0"/>
      <arg name="y" value="0.0"/>
    </include>
    <node name="lee_geometric_controller_node" pkg="rotors_control" type="lee_geometric_controller_node" output="screen">
      <rosparam command="load" file="$(find rotors_gazebo)/resource/$(arg mav_name)_lee_geometric_controller.yaml" />
      <rosparam command="load" file="$(find rotors_gazebo)/resource/$(arg mav_name)_forster_motor_parameters.yaml" />
    </node>
    <node name="piecewise_trajectory_generator" pkg="rotors_gazebo" type="piecewise_trajectory_generator" output="screen">
      <rosparam command="load" file="$(find rotors_gazebo)/resource/trajectories/swarm_$(arg mav_name)_2.yaml" />
    </node>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
  </group>

  <!-- CRAZYFLIE_3 -->
  <group ns="$(arg mav_name)_3">
    <include file="$(find rotors_gazebo)/launch/spawn_mav_crazyflie.launch">
      <arg name="mav_name" value="$(arg mav_name)" />
      <arg name="namespace" value="$(arg mav_name)_3" />
      <arg name="model" value="$(find rotors_description)/urdf/mav_generic_odometry_sensor.gazebo" />
      <arg name="enable_logging" value="$(arg enable_logging)" />
      <arg name="enable_ground_truth" value="$(arg enable_ground_truth)" />
      <arg name="log_file" value="$(arg mav_name)_3"/>
      <arg name="forster_parameters" value="true"/>
      <!-- Set the initial position -->
      <arg name="x" value="1.0"/>
      <arg name="y" value="-1.0"/>
    </include>
    <node name="lee_geometric_controller_node" pkg="rotors_control" type="lee_geometric_controller_node" output="screen">
      <rosparam command="load" file="$(find rotors_gazebo)/resource/$(arg mav_name)_lee_geometric_controller.yaml" />
      <rosparam command="load" file="$(find rotors_gazebo)/resource/$(arg mav_name)_forster_motor_parameters.yaml" />
    </node>
    <node name="piecewise_trajectory_generator" pkg="rotors_gazebo" type="piecewise_trajectory_generator" output="screen">
      <rosparam command="load" file="$(find rotors_gazebo)/resource/trajectories/swarm_$(arg mav_name)_3.yaml" />
    </node>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" />
  </group>
</launch>
