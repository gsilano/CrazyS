<?xml version="1.0"?>
<!--
  Physical parameters of the Crazyflie 2.x.

  Two sets of propeller coefficients are available:
    - default: the ones used by CrazyS since the first release;
    - forster: identified by J. Forster ("System Identification of the Crazyflie 2.0
      Nano Quadrocopter", Bachelor's thesis, ETH Zurich, 2015), used to tune the Lee
      geometric controller.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="rotor_velocity_slowdown_sim" value="50" />
  <xacro:property name="mesh_file" value="package://rotors_description/meshes/crazyflie2.dae" />
  <xacro:property name="mass" value="0.025" /> <!-- [kg], body only, rotors excluded -->
  <xacro:property name="body_width" value="0.045" /> <!-- [m] -->
  <xacro:property name="body_height" value="0.03" /> <!-- [m] -->
  <xacro:property name="mass_rotor" value="0.0005" /> <!-- [kg] -->
  <xacro:property name="arm_length" value="0.046" /> <!-- [m] -->
  <xacro:property name="rotor_offset_top" value="0.024" /> <!-- [m] -->
  <xacro:property name="radius_rotor" value="0.0225" /> <!-- [m] -->
  <xacro:property name="sin45" value="0.707106781186" />
  <xacro:property name="cos45" value="0.707106781186" />
  <xacro:property name="time_constant_up" value="0.0125" /> <!-- [s] -->
  <xacro:property name="time_constant_down" value="0.025" /> <!-- [s] -->
  <xacro:property name="inertia_xx" value="1.657171e-05" /> <!-- [kg m^2] -->
  <xacro:property name="inertia_yy" value="1.657171e-05" /> <!-- [kg m^2] -->
  <xacro:property name="inertia_zz" value="2.9261652e-05" /> <!-- [kg m^2] -->

  <xacro:if value="${forster_parameters}">
    <xacro:property name="motor_constant" value="1.71465181e-08" /> <!-- [kg m] -->
    <xacro:property name="moment_constant" value="0.004459273" /> <!-- [m] -->
    <xacro:property name="max_rot_velocity" value="3052" /> <!-- [rad/s] -->
    <xacro:property name="rotor_drag_coefficient" value="1.066428e-06" />
    <xacro:property name="rolling_moment_coefficient" value="0.0" />
  </xacro:if>
  <xacro:unless value="${forster_parameters}">
    <xacro:property name="motor_constant" value="1.28192e-08" /> <!-- [kg m] -->
    <xacro:property name="moment_constant" value="5.964552e-03" /> <!-- [m] -->
    <xacro:property name="max_rot_velocity" value="2618" /> <!-- [rad/s] -->
    <xacro:property name="rotor_drag_coefficient" value="8.06428e-05" />
    <xacro:property name="rolling_moment_coefficient" value="0.000001" />
  </xacro:unless>
</robot>
